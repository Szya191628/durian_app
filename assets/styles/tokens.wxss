/* Hallmark · macrostructure: Photographic catalogue · tone: modern minimal · anchor hue: forest
 * Native WXSS: sRGB tokens and device Chinese fonts preserve WeChat compatibility. */
page {
  --color-bg: #F7F8F4; --color-surface: #FFFFFF; --color-ink: #20392F;
  --color-primary: #254D3E; --color-primary-soft: #E8EFE9; --color-gold: #EDD18A;
  --color-gold-soft: #F8F0DB; --color-muted: #657268; --color-border: #E1E6DE;
  --color-cream: #F4EBDD; --color-danger: #9B3E32; --color-danger-soft: #F8EDE9;
  --color-overlay: rgba(21,38,29,.45); --color-transparent: transparent;
  --color-shadow: rgba(30,55,39,.06); --color-on-primary: #FFFFFF;
  --font-body: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --font-number: 'DIN Alternate', 'Arial', sans-serif;
  --space-xs: 8rpx; --space-sm: 16rpx; --space-md: 24rpx; --space-lg: 32rpx; --space-xl: 48rpx;
  --radius-sm: 16rpx; --radius-md: 24rpx; --radius-lg: 32rpx;
  --ease-out: cubic-bezier(.16,1,.3,1); --ease-in: cubic-bezier(.7,0,.84,0); --ease-in-out: cubic-bezier(.65,0,.35,1);
}
/* Future theme can override this one token scope; system dark mode is not enabled yet. */
.theme-dark { --color-bg: #14251D; --color-surface: #1F3429; --color-ink: #ECF1E8; --color-muted: #B5C2B7; --color-border: #3C5142; --color-primary-soft: #314B3B; }
