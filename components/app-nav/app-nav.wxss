.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 80; background: var(--color-bg); } .nav-row { display: flex; align-items: center; padding-left: 32rpx; gap: 16rpx; } .nav-copy { min-width: 0; } .nav-title { font-size: 34rpx; font-weight: 700; white-space: nowrap; } .nav-subtitle { display: block; font-size: 19rpx; line-height: 1.2; letter-spacing: 2rpx; color: var(--color-muted); } .back { width: 64rpx; min-height: 80rpx; display: flex; align-items: center; } .brand-mark { width: 58rpx; height: 58rpx; border-radius: 18rpx 18rpx 18rpx 4rpx; background: var(--color-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
