.metric { padding:28rpx; background:var(--color-surface); border-radius:22rpx; border:2rpx solid var(--color-border); min-height:200rpx; } .metric-dark { background:var(--color-primary); color:var(--color-on-primary); border-color:var(--color-primary); } .metric-label { font-size:25rpx; } .metric-value { display:block; font-family:var(--font-number); font-size:52rpx; line-height:1.2; font-weight:600; margin:22rpx 0 12rpx; } .metric-note { font-size:22rpx; opacity:.8; }
