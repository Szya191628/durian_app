<button class="order-card enter" bindtap="open" hover-class="press"><view class="row between"><text class="caption">{{order.dateText}}</text><text class="tag">{{order.statusText}}</text></view><view class="order-product row" wx:for="{{order.items}}" wx:key="productId"><view class="thumb"><image src="{{item.image || '/assets/icons/leaf-green.png'}}" mode="aspectFit" lazy-load /></view><view class="grow"><text class="item-name">{{item.name}}</text><text class="caption">{{item.spec}}</text></view><text class="caption">×{{item.quantity}}</text></view><view class="row between order-bottom"><text class="caption">查看详情 <text>›</text></text><text class="small">合计 <text class="order-amount">¥{{order.amountText}}</text></text></view></button>
