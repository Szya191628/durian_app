.state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 28rpx; text-align: center; gap: 22rpx; } .state-title { font-size: 32rpx; font-weight: 600; } .state-desc { color: var(--color-muted); font-size: 26rpx; max-width: 520rpx; } .skeleton { padding: 20rpx 0; } .skeleton-heading,.skeleton-line,.skeleton-square { background: var(--color-border); border-radius: 12rpx; animation: pulse 1.4s var(--ease-in-out) infinite; } .skeleton-heading { height: 44rpx; width: 45%; margin-bottom: 24rpx; } .skeleton-line { height: 24rpx; width: 60%; margin-bottom: 20rpx; } .skeleton-row { display: flex; gap: 24rpx; margin-top: 32rpx; } .skeleton-square { width: 160rpx; height: 148rpx; } .wide { width: 95%; } .short { width: 40%; } @media(prefers-reduced-motion:reduce) { .skeleton-line,.skeleton-heading,.skeleton-square { animation:none; } }
