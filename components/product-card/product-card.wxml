<view class="product enter"><button class="product-open" bindtap="open" hover-class="press" aria-label="查看{{product.name}}"><view class="product-photo"><image wx:if="{{product.image && !failed}}" class="product-image" src="{{product.image}}" mode="aspectFill" lazy-load binderror="imageError" /><view wx:else class="product-placeholder"><ui-icon name="leaf" size="90" /><text>商品图片待补充</text></view><text wx:if="{{product.stock === 0}}" class="sold">暂时售罄</text><text wx:elif="{{product.categoryName}}" class="product-category">{{product.categoryName}}</text><text wx:if="{{product.stock > 0 && product.stock <= 5}}" class="stock-tag">仅剩 {{product.stock}}{{product.unit || '件'}}</text></view><view class="product-body"><text class="product-name">{{product.name}}</text><text class="product-spec">{{product.spec || '查看商品规格'}}</text></view></button><view class="product-bottom"><view class="grow"><text class="currency">¥</text><text class="product-price">{{product.priceText}}</text></view><button class="add" disabled="{{product.stock === 0}}" bindtap="add" hover-class="press" aria-label="加入购物袋">+</button></view></view>
