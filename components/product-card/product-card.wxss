.product { background:var(--color-surface); border-radius:24rpx; overflow:hidden; border:2rpx solid var(--color-border); } .product-open { width:100%; text-align:left; } .product-photo { height:292rpx; position:relative; background:var(--color-cream); } .product-image { width:100%;height:100%; } .product-placeholder { height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;color:var(--color-muted);font-size:21rpx; } .product-category,.sold { position:absolute;top:16rpx;left:16rpx;background:var(--color-surface);padding:4rpx 14rpx;border-radius:8rpx;font-size:21rpx; } .sold { background:var(--color-primary);color:var(--color-on-primary); } .stock-tag { position:absolute;bottom:16rpx;left:16rpx;background:var(--color-gold-soft);color:var(--color-ink);padding:4rpx 14rpx;border-radius:8rpx;font-size:21rpx; } .product-body { padding:22rpx 22rpx 0; } .product-name { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:29rpx;font-weight:650;line-height:1.4;min-height:80rpx; } .product-spec { display:block;font-size:23rpx;color:var(--color-muted);margin:10rpx 0;min-height:36rpx; } .product-bottom { padding:0 18rpx 18rpx 22rpx;display:flex;align-items:center;gap:4rpx; } .product-price { font-family:var(--font-number);font-size:38rpx;font-weight:700;letter-spacing:-1rpx; } .add { display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;border-radius:22rpx;background:var(--color-primary);color:var(--color-on-primary);font-size:42rpx; }
