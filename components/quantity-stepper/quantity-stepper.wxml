<view class="stepper"><button disabled="{{disabled || value <= 1}}" class="step" data-delta="-1" bindtap="change" hover-class="press" aria-label="减少数量">−</button><text class="quantity">{{value}}</text><button disabled="{{disabled || value >= max}}" class="step" data-delta="1" bindtap="change" hover-class="press" aria-label="增加数量">+</button></view>
