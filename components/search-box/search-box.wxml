<view class="search" bindtap="activate"><ui-icon name="search" size="36" /><text wx:if="{{readonly}}" class="placeholder grow">{{placeholder}}</text><input wx:else class="search-input" value="{{value}}" placeholder="{{placeholder}}" placeholder-class="placeholder" confirm-type="search" maxlength="60" bindinput="input" bindconfirm="search" aria-label="搜索商品" /><button wx:if="{{value && !readonly}}" class="clear" catchtap="clear" aria-label="清除搜索"><ui-icon name="close" size="28" /></button></view>
