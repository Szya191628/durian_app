.tabs { width:100%; white-space:nowrap; } .tabs-inner { display:inline-flex; gap:12rpx; min-width:100%; border-bottom:2rpx solid var(--color-border); } .tab { flex-shrink:0; padding:24rpx 22rpx; font-size:28rpx; color:var(--color-muted); position:relative; } .active { color:var(--color-primary); font-weight:650; } .tab-line { height:5rpx; background:var(--color-primary); position:absolute; bottom:0; left:25%; right:25%; border-radius:4rpx; transform:scaleX(0); transition:transform 200ms var(--ease-out); } .active .tab-line { transform:scaleX(1); }
