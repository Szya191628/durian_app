<app-nav title="收货信息" /><view class="screen with-dock"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry" /><view wx:if="{{!loading && !error}}"><view class="heading">留一个，收货的地方。</view><text class="caption">请填写准确的信息，方便店铺联系与配送</text><view class="card section">
<view class="field"><text class="field-label">收货人</text><input class="input {{validation.name ? 'input-error' : ''}}" placeholder="收货人姓名" value="{{form.name}}" data-field="name" bindinput="input" maxlength="30" /><text class="error-text">{{validation.name}}</text></view>
<view class="field"><text class="field-label">手机号码</text><input class="input {{validation.phone ? 'input-error' : ''}}" placeholder="用于配送联系" type="number" value="{{form.phone}}" data-field="phone" bindinput="input" maxlength="11" /><text class="error-text">{{validation.phone}}</text></view>
<view class="field"><text class="field-label">所在地区</text><picker mode="region" value="{{region}}" bindchange="region"><view class="input row between"><text>{{region.length ? region[0] + ' ' + region[1] + ' ' + region[2] : '选择省 / 市 / 区'}}</text><ui-icon name="down" size="28" /></view></picker><text class="error-text">{{validation.region}}</text></view>
<view class="field"><text class="field-label">详细地址</text><textarea class="input textarea {{validation.detail ? 'input-error' : ''}}" placeholder="街道、小区、楼栋及门牌号" value="{{form.detail}}" data-field="detail" bindinput="input" maxlength="200" /><text class="error-text">{{validation.detail}}</text></view>
<view class="row between"><text>设为默认地址</text><switch checked="{{form.isDefault}}" bindchange="default" color="#254D3E" /></view></view><text class="form-help">收货信息仅用于订单配送与店铺联系。</text></view></view><view wx:if="{{!loading && !error}}" class="dock"><button class="primary" loading="{{busy}}" disabled="{{busy || saved}}" bindtap="save" hover-class="press">{{saved ? '地址已保存' : '保存地址'}}</button></view>
