<app-nav title="{{selecting ? '选择收货地址' : '收货地址'}}" /><view class="screen with-dock"><view class="heading">把美味，送到你身边。</view><text class="caption">{{selecting ? '点击地址即可用于本次订单' : '管理常用地址，让下单更轻松'}}</text><view class="section"><page-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" title="还没有收货地址" description="添加一个地址，下次下单就能直接选择。" action-text="添加地址" bindaction="add" bindretry="retry" /><view wx:if="{{!loading && !error}}" class="stack"><view class="card enter" wx:for="{{items}}" wx:key="_id"><button class="address-main" data-id="{{item._id}}" bindtap="choose" hover-class="{{selecting ? 'press' : 'none'}}"><view class="row"><text class="subheading">{{item.name}}</text><text class="caption">{{item.phone}}</text><text wx:if="{{item.isDefault}}" class="tag">默认</text></view><text class="address-copy">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text></button><view class="address-actions"><button class="text-button" data-id="{{item._id}}" bindtap="default" disabled="{{busy || item.isDefault}}">{{item.isDefault ? '默认地址' : '设为默认'}}</button><view class="grow"></view><button class="text-button" data-id="{{item._id}}" bindtap="edit" disabled="{{busy}}">编辑</button><button class="text-button muted" data-id="{{item._id}}" bindtap="remove" disabled="{{busy}}">删除</button></view></view></view><list-footer wx:if="{{!loading && !error}}" loading="{{loadingMore}}" error="{{moreError}}" has-more="{{hasMore}}" count="{{items.length}}" bindretry="onReachBottom" /></view></view><view class="dock"><button class="primary" bindtap="add" hover-class="press">＋ 添加收货地址</button></view>
