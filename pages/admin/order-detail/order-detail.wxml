<app-nav title="订单详情" /><view class="screen with-dock"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry" /><view wx:if="{{!loading && !error && order}}" class="stack enter"><view class="order-status"><ui-icon name="{{order.status === 'completed' ? 'check' : 'box'}}" tone="white" size="64" /><view class="heading">{{order.statusText}}</view><text>{{statusDescription}}</text><view class="progress" wx:if="{{order.status !== 'cancelled'}}"><view wx:for="{{steps}}" wx:key="label" class="progress-step {{item.done ? 'done' : ''}}"><view class="progress-dot">{{item.done ? '✓' : '·'}}</view><text>{{item.label}}</text></view></view></view>
<view class="card" wx:if="{{order.trackingNo}}"><view class="row between"><text class="subheading">物流信息</text><button class="text-button" bindtap="copyTracking">复制单号</button></view><text class="wrap">{{order.trackingNo}}</text></view>
<view class="card"><view class="row"><ui-icon name="pin" size="40" /><text class="subheading">收货信息</text></view><view class="section"><text>{{order.address.name}}　{{order.address.phone}}</text><text class="address-detail">{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</text></view><button wx:if="{{admin}}" class="text-button" bindtap="call">联系收货人</button></view>
<view class="card"><text class="subheading">商品信息</text><view class="row list-item" wx:for="{{order.items}}" wx:key="productId"><view class="thumb"><image src="{{item.image || '/assets/icons/leaf-green.png'}}" mode="aspectFit" lazy-load /></view><view class="grow"><text class="item-name">{{item.name}}</text><text class="caption">{{item.spec}}</text><view class="row between"><text>¥{{item.priceText}}</text><text class="caption">× {{item.quantity}}</text></view></view></view><view class="row between section"><text>实付金额</text><text class="price"><text class="currency">¥</text>{{order.amountText}}</text></view></view>
<view class="card"><text class="subheading">订单记录</text><info-row label="订单编号" value="{{order.orderNo}}" /><button class="text-button" bindtap="copy">{{copied ? '已复制订单编号' : '复制订单编号'}}</button><info-row label="下单时间" value="{{order.dateText}}" /><info-row label="付款时间" value="{{order.paidText}}" /><info-row label="发货时间" value="{{order.shippedText}}" /><info-row label="支付方式" value="{{payTypeText}}" /><view wx:if="{{order.remark}}" class="section"><text class="caption">买家留言</text><text class="address-detail">{{order.remark}}</text></view></view>
<view class="card" wx:if="{{admin && (order.status === 'paid' || order.status === 'shipped')}}"><text class="field-label">快递单号</text><input class="input" value="{{trackingNo}}" bindinput="tracking" maxlength="60" placeholder="输入真实物流单号" /><button wx:if="{{order.status === 'shipped'}}" class="secondary section" disabled="{{busy}}" bindtap="saveTracking" hover-class="press">更新物流信息</button></view>
</view></view><view class="dock" wx:if="{{!loading && !error && order}}"><button wx:if="{{!admin}}" class="secondary" open-type="contact" hover-class="press">联系店铺</button><button wx:if="{{admin && order.status === 'pending'}}" class="secondary" disabled="{{busy}}" bindtap="cancelOrder" hover-class="press">取消订单</button><button wx:if="{{admin && order.status === 'pending'}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="confirmPay" hover-class="press">确认收款</button><button wx:if="{{admin && order.status === 'paid'}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="ship" hover-class="press">确认发货</button><button wx:if="{{order.status === 'shipped'}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="receive" hover-class="press">{{admin ? '完成订单' : '确认收货'}}</button><text wx:if="{{admin && order.status !== 'pending' && order.status !== 'paid' && order.status !== 'shipped'}}" class="caption">当前订单暂无待处理操作</text></view>
