<app-nav title="商品编辑" /><view class="screen with-dock"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry" /><view wx:if="{{!loading && !error}}"><view class="heading">好商品，认真介绍。</view><text class="caption">完整的信息，让顾客更容易做出选择</text><view class="card section"><view class="field-label">商品图片</view><view class="image-grid"><view wx:for="{{form.images}}" wx:key="*this" class="uploaded"><image src="{{item}}" mode="aspectFill" /><button data-index="{{index}}" bindtap="removeImage" disabled="{{uploading || busy}}" aria-label="移除图片">×</button></view><button wx:if="{{form.images.length < 6}}" class="upload" bindtap="upload" disabled="{{uploading || busy}}" loading="{{uploading}}"><ui-icon name="plus" size="40" /><text>上传图片</text></button></view><text class="form-help">最多 6 张，每张不超过 5 MB。第一张作为商品封面。</text></view>
<view class="card section">
<view class="field"><text class="field-label">商品名称</text><input class="input {{validation.name ? 'input-error' : ''}} {{focused === 'name' ? 'input-focus' : ''}}" value="{{form.name}}" data-field="name" bindinput="input" bindfocus="focus" bindblur="blur" placeholder="例如：猫山王果肉" maxlength="60" /><text class="error-text">{{validation.name}}</text></view>
<view class="field"><text class="field-label">商品分类</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="input row between"><text>{{categories[categoryIndex].name || '请选择分类'}}</text><ui-icon name="down" size="28" /></view></picker><text class="error-text">{{validation.category}}</text></view>
<view class="grid"><view class="field"><text class="field-label">售价（元）</text><input class="input {{validation.price ? 'input-error' : ''}}" type="digit" value="{{form.price}}" data-field="price" bindinput="input" maxlength="9" placeholder="0.00" /><text class="error-text">{{validation.price}}</text></view><view class="field"><text class="field-label">划线价（选填）</text><input class="input" type="digit" value="{{form.originalPrice}}" data-field="originalPrice" bindinput="input" maxlength="9" placeholder="0.00" /><text class="error-text">{{validation.originalPrice}}</text></view></view>
<view class="field"><text class="field-label">规格</text><input class="input" value="{{form.spec}}" data-field="spec" bindinput="input" placeholder="例如：400g / 盒" maxlength="80" /><text class="error-text">{{validation.spec}}</text></view>
<view class="grid"><view class="field"><text class="field-label">库存</text><input class="input" type="number" value="{{form.stock}}" data-field="stock" bindinput="input" maxlength="6" /><text class="error-text">{{validation.stock}}</text></view><view class="field"><text class="field-label">单位</text><input class="input" value="{{form.unit}}" data-field="unit" bindinput="input" placeholder="个 / 盒" maxlength="8" /><text class="error-text">{{validation.unit}}</text></view></view>
<view class="field"><text class="field-label">排序值</text><input class="input" type="number" value="{{form.sort}}" data-field="sort" bindinput="input" maxlength="6" /><text class="form-help">数值越小，商品排序越靠前。</text><text class="error-text">{{validation.sort}}</text></view>
<view class="field"><text class="field-label">商品介绍</text><textarea class="input textarea" value="{{form.description}}" data-field="description" bindinput="input" maxlength="2000" placeholder="描述口感、产地、保存方式等真实信息" /></view><view class="row between"><text>立即上架</text><switch checked="{{form.status === 1}}" bindchange="status" color="#254D3E" /></view>
</view></view></view><view wx:if="{{!loading && !error}}" class="dock"><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || uploading || saved}}" hover-class="press">{{saved ? '商品已保存' : '保存商品'}}</button></view>
