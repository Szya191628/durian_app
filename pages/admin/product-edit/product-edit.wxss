.image-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx; } .uploaded,.upload { height:174rpx;position:relative;border-radius:16rpx;background:var(--color-primary-soft);overflow:hidden; } .uploaded image { width:100%;height:100%; } .uploaded button { position:absolute;right:0;top:0;width:60rpx;height:60rpx;border-radius:0 0 0 16rpx;background:var(--color-primary);color:var(--color-on-primary);font-size:36rpx; } .upload { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;font-size:23rpx; }
