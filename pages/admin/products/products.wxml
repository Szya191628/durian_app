<app-nav title="商品管理" /><view class="screen with-dock"><view class="heading">让每一款，都值得选。</view><text class="caption">管理商品信息、库存与销售状态</text><view class="section"><ui-tabs items="{{tabs}}" value="{{status}}" bindchange="change" /></view><view class="section"><page-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" title="暂无商品" description="添加第一款商品，开始你的榴莲生意。" action-text="添加商品" bindaction="add" bindretry="retry" /><view wx:if="{{!loading && !error}}" class="stack"><view wx:for="{{items}}" wx:key="_id" class="card enter"><button class="row product-info" data-id="{{item._id}}" bindtap="edit"><view class="thumb"><image src="{{item.image || '/assets/icons/leaf-green.png'}}" mode="aspectFit" lazy-load /></view><view class="grow"><view class="row between"><text class="item-name">{{item.name}}</text><text class="tag">{{item.status === 1 ? '在售' : '已下架'}}</text></view><text class="caption">{{item.spec}} · 库存 {{item.stock}}</text><view class="price"><text class="currency">¥</text>{{item.priceText}}</view></view></button><view class="row between product-actions"><button class="text-button" data-id="{{item._id}}" bindtap="edit" disabled="{{busy}}">编辑商品</button><view class="row"><button class="text-button" data-id="{{item._id}}" bindtap="toggle" disabled="{{busy}}">{{item.status === 1 ? '下架' : '上架'}}</button><button class="text-button muted" data-id="{{item._id}}" bindtap="remove" disabled="{{busy}}">删除</button></view></view></view></view><list-footer wx:if="{{!loading && !error}}" loading="{{loadingMore}}" error="{{moreError}}" has-more="{{hasMore}}" count="{{items.length}}" bindretry="onReachBottom" /></view></view><view wx:if="{{!error && !loading}}" class="dock"><button class="primary" bindtap="add" hover-class="press">＋ 添加商品</button></view>
