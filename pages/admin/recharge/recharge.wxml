<app-nav title="手动充值" /><view class="screen"><view class="heading">给顾客加余额。</view><text class="caption">仅店铺管理员可操作，充值即时入账</text><page-state loading="{{loading}}" error="{{error}}" bindretry="retry" /><view wx:if="{{!loading && !error}}" class="stack enter">
<view class="card"><text class="field-label">查找用户</text><view class="row section"><input class="input grow" value="{{keyword}}" bindinput="keyword" placeholder="输入昵称或手机号" maxlength="40" /><button class="secondary" bindtap="search" disabled="{{busy}}" hover-class="press">搜索</button></view><text wx:if="{{searched && !results.length}}" class="caption">没有找到匹配的用户</text><button wx:for="{{results}}" wx:key="_id" class="pick-row" data-id="{{item._id}}" bindtap="pick" hover-class="press"><view class="grow pick-body"><text>{{item.nickName || '未设置昵称'}}</text><text class="caption">{{item.phone || '未留手机号'}} · 当前余额 ¥{{item.balance}}</text></view><text class="pick-check">{{selected._id === item._id ? '●' : '○'}}</text></button></view>
<view wx:if="{{selected}}" class="card"><text class="subheading">充值信息</text><info-row label="用户" value="{{selected.nickName || selected._id}}" /><info-row label="当前余额" value="¥{{selected.balance}}" /><view class="section"><text class="field-label">充值金额（元）</text><input class="input" type="digit" value="{{amount}}" bindinput="amount" placeholder="例如 200" /></view><view class="section"><text class="field-label">备注（选填）</text><input class="input" value="{{note}}" bindinput="note" maxlength="60" placeholder="例如 线下转账已到账" /></view><button class="primary section" bindtap="submit" loading="{{busy}}" disabled="{{busy}}" hover-class="press">确认充值</button><text class="caption">入账后用户可在下单时选择余额抵扣，操作不可撤销。</text></view>
</view></view>
