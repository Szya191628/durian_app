<app-nav title="购物袋" back="{{false}}" /><view class="screen with-dock"><view class="row between"><view><view class="heading">装下一点小满足。</view><text class="caption">{{items.length}} 款好味，等你带回家</text></view><ui-icon name="bag" size="66" /></view>
<page-state empty="{{!items.length}}" title="购物袋还是空的" description="挑一款喜欢的榴莲，让今天甜一点。" action-text="去挑选榴莲" bindaction="shopping" />
<view wx:if="{{items.length}}" class="stack section"><view wx:for="{{items}}" wx:key="productId" class="cart-card enter"><view class="row"><button class="check {{item.selected ? 'checked' : ''}}" data-id="{{item.productId}}" bindtap="toggle" aria-label="{{item.selected ? '取消选中' : '选中'}}{{item.name}}">{{item.selected ? '✓' : ''}}</button><view class="thumb"><image src="{{item.image || '/assets/icons/leaf-green.png'}}" mode="{{item.image ? 'aspectFill' : 'aspectFit'}}" lazy-load /></view><view class="grow"><text class="item-name">{{item.name}}</text><text class="caption">{{item.spec}}</text><view class="row between"><text class="price cart-price"><text class="currency">¥</text>{{item.priceText}}</text><button class="remove" data-id="{{item.productId}}" bindtap="remove" aria-label="移除商品"><ui-icon name="trash" size="30" /></button></view></view></view><view class="row between cart-controls"><text class="caption">{{item.stock === 0 ? '库存不足，请重新选购' : '购买数量'}}</text><quantity-stepper value="{{item.quantity}}" max="{{item.stock}}" data-id="{{item.productId}}" bindchange="quantity" /></view></view></view>
<view wx:if="{{items.length}}" class="notice section">价格与库存将在下单时再次确认。</view></view>
<view wx:if="{{items.length}}" class="dock"><button class="select-all" bindtap="toggleAll"><view class="check {{all ? 'checked' : ''}}">{{all ? '✓' : ''}}</view><text>全选</text></button><view class="grow"><text class="caption">合计</text><view class="price"><text class="currency">¥</text>{{totalText}}</view></view><button class="primary checkout" disabled="{{!count}}" bindtap="checkout" hover-class="press">去结算（{{count}}）</button></view>
<app-modal show="{{modal}}" title="移出购物袋？" confirm-text="确认移除" bindcancel="cancelRemove" bindconfirm="confirmRemove">之后仍然可以在商品页重新加入。</app-modal>
