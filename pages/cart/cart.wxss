.cart-card { padding:26rpx;background:var(--color-surface);border-radius:24rpx;border:2rpx solid var(--color-border); } .check { width:52rpx;height:52rpx;flex-shrink:0;border:2rpx solid var(--color-muted);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:30rpx; } .checked { background:var(--color-primary);border-color:var(--color-primary);color:var(--color-on-primary); } .cart-controls { margin-top:24rpx;padding-top:24rpx;border-top:2rpx solid var(--color-border); } .cart-price { font-size:34rpx; } .remove { width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:flex-end; } .select-all { display:flex;align-items:center;gap:10rpx;font-size:24rpx;min-height:88rpx; } .checkout { flex:none!important;min-width:220rpx;padding:0 20rpx; } .thumb { width:116rpx;height:126rpx; }
