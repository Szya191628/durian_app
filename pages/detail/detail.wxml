<app-nav title="商品详情" /><view class="screen with-dock"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry" />
<view wx:if="{{!loading && !error && product}}" class="enter">
  <view class="detail-media"><swiper wx:if="{{product.images.length && !imageFailed}}" indicator-dots circular><swiper-item wx:for="{{product.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" binderror="imageError" /></swiper-item></swiper><view wx:else class="detail-placeholder"><ui-icon name="leaf" size="144" /><text>商品图片待补充</text></view><text class="detail-tag">{{product.categoryName || '榴莲精选'}}</text></view>
  <view class="section"><view class="row"><view><text class="currency">¥</text><text class="detail-price">{{product.priceText}}</text></view><text wx:if="{{product.originalPrice > product.price}}" class="original">¥{{product.originalText}}</text><text class="tag" wx:if="{{product.stock === 0}}">暂时售罄</text></view><view class="heading">{{product.name}}</view><text class="muted">{{product.spec}}</text></view>
  <view class="card section"><view class="row between"><text class="subheading">选择数量</text><quantity-stepper value="{{quantity}}" max="{{product.stock}}" disabled="{{product.stock === 0}}" bindchange="changeQuantity" /></view><view class="divider"></view><view class="row between caption"><text>规格 · {{product.spec || '以商品说明为准'}}</text><text>库存 {{product.stock}} {{product.unit || '件'}}</text></view></view>
  <view class="detail-services section"><view class="service-item"><ui-icon name="box" size="36" /><view><text class="service-title">规格与包装</text><text class="caption">{{product.spec || '下单前请确认规格'}}</text></view></view><view class="service-item"><ui-icon name="truck" size="36" /><view><text class="service-title">配送说明</text><text class="caption">配送范围与时效以店铺确认</text></view></view><view class="service-item"><ui-icon name="chat" size="36" /><view><text class="service-title">售后咨询</text><text class="caption">生鲜异常请及时联系客服</text></view></view></view>
  <view class="section"><view class="subheading">关于这份美味</view><text class="description">{{product.description || '详细商品介绍正在补充，可联系客服了解。'}}</text></view>
  <view class="notice section">鲜果规格、成熟度、配送及售后规则，请以店铺确认及实际商品说明为准。</view>
</view></view>
<view wx:if="{{!loading && !error && product}}" class="dock"><button class="cart-entry" bindtap="cart" aria-label="购物袋"><ui-icon name="bag" size="42" /><text>购物袋{{cartCount ? ' · ' + cartCount : ''}}</text></button><button class="secondary" disabled="{{product.stock === 0}}" bindtap="add" hover-class="press">加入购物袋</button><button class="primary" disabled="{{product.stock === 0}}" bindtap="buy" hover-class="press">立即购买</button></view>
