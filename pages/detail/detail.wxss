.detail-media { position:relative;height:620rpx;background:var(--color-cream);border-radius:28rpx;overflow:hidden; } .detail-media swiper,.detail-media image { width:100%;height:100%; } .detail-placeholder { height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:30rpx;color:var(--color-muted); } .detail-tag { position:absolute;bottom:28rpx;left:28rpx;background:var(--color-surface);padding:10rpx 22rpx;border-radius:12rpx;font-size:24rpx; } .detail-price { font-family:var(--font-number);font-size:64rpx;font-weight:700;letter-spacing:-2rpx; } .detail-services { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx; } .service-item { min-width:0;background:var(--color-surface);border:2rpx solid var(--color-border);border-radius:18rpx;padding:20rpx 14rpx;display:flex;flex-direction:column;gap:10rpx; } .service-title { display:block;font-size:24rpx;font-weight:600;margin-bottom:4rpx; } .service-item .caption { display:block;line-height:1.45;font-size:21rpx; } .description { display:block;white-space:pre-wrap;line-height:1.9;color:var(--color-muted);margin-top:24rpx; } .cart-entry { width:120rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:center;font-size:20rpx;gap:6rpx; } .dock { gap:12rpx; } .dock .primary,.dock .secondary { padding:0 16rpx;font-size:26rpx; }
