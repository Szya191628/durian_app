.block { display:block;margin-top:8rpx; }
.hero { position:relative;height:432rpx;border-radius:28rpx;overflow:hidden;background:var(--color-cream);margin-top:28rpx; }
.hero-image { position:absolute;inset:0;width:100%;height:100%; }
.hero-copy { position:relative;padding:38rpx 32rpx;max-width:68%; }
.hero-label { font-size:23rpx;letter-spacing:4rpx; }
.hero-title { display:block;white-space:pre-line;font-size:52rpx;font-weight:700;line-height:1.22;letter-spacing:-2rpx;margin:24rpx 0 18rpx; }
.hero-description { font-size:22rpx;display:block;white-space:nowrap; }
.hero-cta { display:inline-flex;align-items:center;gap:12rpx;margin-top:28rpx;min-height:72rpx;padding:0 22rpx;background:var(--color-surface);border-radius:14rpx;font-size:25rpx;font-weight:600; }
.hero-caption { position:absolute;bottom:12rpx;right:16rpx;font-size:18rpx;background:var(--color-cream);padding:2rpx 8rpx;border-radius:6rpx; }
.quick-facts { display:flex;justify-content:space-between;gap:8rpx;border-bottom:2rpx solid var(--color-border);padding:28rpx 0; }
.quick-facts>view { display:flex;align-items:center;gap:8rpx;font-size:22rpx;color:var(--color-muted); }
.category-inner { display:inline-flex;gap:30rpx; }
.category-strip { white-space:nowrap; }
.category-tile { width:112rpx;text-align:center;font-size:24rpx;flex-shrink:0; }
.category-symbol { display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;border-radius:32rpx;background:var(--color-primary-soft);margin:0 auto 16rpx; }
.category-tile:nth-child(even) .category-symbol { background:var(--color-gold-soft); }
.selection-heading { display:flex;justify-content:space-between;align-items:center;margin-bottom:26rpx; }
.selection-count { display:flex;align-items:baseline;gap:10rpx;font-size:22rpx;color:var(--color-muted); }
.selection-number { font-family:var(--font-number);font-size:38rpx;color:var(--color-primary);font-weight:600; }
.category-heading { margin-bottom:20rpx; }
.brand-footer { padding:48rpx 0 0;display:flex;align-items:center;justify-content:center;gap:12rpx;font-size:22rpx;color:var(--color-muted); }
