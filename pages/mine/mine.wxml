<app-nav title="我的" back="{{false}}" /><view class="screen"><page-state loading="{{loading}}" error="{{error}}" bindretry="retry" /><view wx:if="{{!loading && !error}}" class="stack enter">
<button class="profile" bindtap="login" hover-class="press"><view class="avatar"><image wx:if="{{user && user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill" /><ui-icon wx:else name="user" size="58" /></view><view class="grow"><text class="profile-name">{{user ? (user.nickName || '榴莲爱好者') : '欢迎来到榴夏来榴莲生鲜'}}</text><text class="caption profile-desc">{{user ? '每一份偏爱，都值得被认真对待' : '登录后，管理你的订单与收货地址'}}</text></view><ui-icon name="right" size="30" /></button>
<view class="member-banner"><view class="row between"><text class="subheading">榴夏来榴莲生鲜会员</text><text class="member-emblem">LIU XIA LAI</text></view><view class="member-values"><view><text class="member-label">账户余额（元）</text><text class="member-number">{{user ? balanceText : '—'}}</text></view><view><text class="member-label">我的积分</text><text class="member-number">{{user ? pointsText : '—'}}</text></view></view><button class="member-link" bindtap="member" hover-class="press">查看会员账户 <ui-icon name="right" tone="white" size="28" /></button></view>
<view class="card"><view class="row between"><text class="subheading">我的订单</text><button class="text-button" bindtap="order">全部订单 <ui-icon name="right" size="26" /></button></view><view wx:if="{{user}}" class="order-shortcuts"><button wx:for="{{orderCounts}}" wx:key="key" data-status="{{item.key}}" bindtap="order" hover-class="press"><ui-icon name="{{item.icon}}" size="44" /><text class="order-count">{{item.value}}</text><text>{{item.label}}</text></button></view><view wx:else class="guest-orders"><text class="caption">登录后查看购买记录与配送进度</text><button class="text-button" bindtap="login">去登录</button></view><button wx:if="{{countsError}}" class="text-button" bindtap="refresh">订单数量暂未同步，点击重试</button></view>
<view class="card tools-card"><info-row icon="pin" label="收货地址" value="管理" arrow bindactivate="addresses" /><button wx:if="{{supportPhone}}" class="contact-row" bindtap="call" hover-class="press"><ui-icon name="chat" size="38" /><text class="grow">拨打店铺电话</text><ui-icon name="right" size="30" /></button><button class="contact-row" open-type="contact" hover-class="press"><ui-icon name="chat" size="38" /><text class="grow">联系店铺</text><ui-icon name="right" size="30" /></button><info-row wx:if="{{user && user.role === 'admin'}}" icon="grid" label="店铺工作台" value="管理员" arrow bindactivate="admin" /></view><text class="end-note">榴夏来榴莲生鲜 · 让每一次选择，都有回味</text>
</view></view>
