.profile { display:flex;align-items:center;gap:24rpx;text-align:left;padding:16rpx 0 8rpx; } .avatar { width:116rpx;height:116rpx;border-radius:40rpx;background:var(--color-primary-soft);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden; } .avatar image { width:100%;height:100%; } .profile-name { font-size:38rpx;font-weight:650;display:block; } .profile-desc { display:block;margin-top:10rpx; } .member-banner { background:var(--color-primary);color:var(--color-on-primary);padding:32rpx;border-radius:28rpx; } .member-emblem { font-size:17rpx;letter-spacing:2rpx;opacity:.8; } .member-values { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32rpx;margin:32rpx 0 24rpx; } .member-label { display:block;font-size:23rpx;opacity:.85; } .member-number { font-family:var(--font-number);font-size:56rpx;font-weight:500; } .member-link { display:flex;align-items:center;justify-content:space-between;border-top:2rpx solid var(--color-muted);padding-top:24rpx;font-size:25rpx;width:100%; } .order-shortcuts { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8rpx;margin-top:24rpx; } .order-shortcuts button { display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:24rpx; } .order-count { font-family:var(--font-number);font-size:32rpx;font-weight:600; } .contact-row { display:flex;align-items:center;gap:20rpx;width:100%;min-height:108rpx;text-align:left; } .tools-card { padding-top:0;padding-bottom:0; } .guest-orders { padding-top:16rpx; }
