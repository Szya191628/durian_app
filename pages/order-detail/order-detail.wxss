.order-status { padding:36rpx;border-radius:28rpx;background:var(--color-primary);color:var(--color-on-primary); } .order-status>text { font-size:26rpx; } .progress { display:flex;justify-content:space-between;gap:8rpx;margin-top:40rpx; } .progress-step { opacity:.55;display:flex;flex-direction:column;align-items:center;gap:12rpx;font-size:21rpx; } .done { opacity:1; } .progress-dot { width:38rpx;height:38rpx;border:2rpx solid var(--color-on-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24rpx; } .done .progress-dot { background:var(--color-gold);color:var(--color-primary);border-color:var(--color-gold); } .address-detail { display:block;margin-top:14rpx;color:var(--color-muted);font-size:26rpx;overflow-wrap:anywhere; }
