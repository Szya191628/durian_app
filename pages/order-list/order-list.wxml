<app-nav title="{{admin ? '订单管理' : '我的订单'}}" /><view class="screen"><view class="heading">{{admin ? '每一单，都妥帖。' : '美味，正在路上。'}}</view><text class="caption">{{admin ? '查看订单，安排发货，跟进交付' : '从下单到收货，随时掌握进度'}}</text><view class="section"><ui-tabs items="{{tabs}}" value="{{status}}" bindchange="change" /></view><view class="section"><page-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" title="暂无相关订单" description="订单更新后，会出现在这里。" action-text="{{admin ? '' : '去挑选榴莲'}}" bindretry="retry" bindaction="shopping" /><block wx:if="{{!loading && !error}}"><order-card wx:for="{{items}}" wx:key="_id" order="{{item}}" bindopen="open" /><list-footer loading="{{loadingMore}}" error="{{moreError}}" count="{{items.length}}" has-more="{{hasMore}}" bindretry="onReachBottom" /></block></view></view>
